# PostgreSQL connection string used by Prisma.
# Run `npx prisma dev` for a local Prisma Postgres dev server, or point this at your own database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Port the Express server listens on.
PORT=3000

# Secret used to sign JWT tokens for client and admin login.
JWT_SECRET="replace-with-a-random-value"

# Google Gemini API key, used to enrich the home page with AI-sourced data.
# Leave empty to disable that feature (the route returns "indisponível").
GEMINI_API_KEY=""

# Deployed frontend URL, used to restrict CORS in production.
# Leave empty in local dev to allow any origin.
FRONTEND_URL=""
